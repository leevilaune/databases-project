# Copy to application.properties (which is gitignored) and fill in the credentials.
spring.datasource.url=jdbc:mariadb://localhost:3306/asd
# least-privilege account created by db/06_security.sql
spring.datasource.username=${DB_USER:vendor_api}
spring.datasource.password=${DB_PASSWORD:change-me-api}

# the schema is managed by the SQL script db/vendor_api.sql (indexes, views, triggers),
# so Hibernate must not try to change it
spring.jpa.hibernate.ddl-auto=none
spring.jpa.open-in-view=false

spring.jpa.show-sql=false
